<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/blush_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/greeting" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/tagline" android:textColor="@color/text_secondary"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Wellness score" android:textColor="@color/text_secondary"/>
        <TextView android:id="@+id/tvWellnessScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--" android:textColor="@color/rose_dark" android:textSize="42sp" android:textStyle="bold"/>
        <ProgressBar android:id="@+id/progressWellness" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp" android:max="100"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Hydration" android:textStyle="bold"/>
            <TextView android:id="@+id/tvWater" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 8"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAddWater"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="+ 1 glass" app:cornerRadius="14dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Sleep" android:textStyle="bold"/>
            <TextView android:id="@+id/tvSleep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- hrs"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Energy" android:textStyle="bold"/>
            <TextView android:id="@+id/tvEnergyHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- / 10"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Your wellness tools" android:textColor="@color/text_primary" android:textStyle="bold"/>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardHydration"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp"
                android:text="Hydration Tracker  ›" android:textColor="@color/text_primary"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardWorkout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workout Planner" android:textStyle="bold"/>
                <TextView android:id="@+id/tvWorkoutHome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="No workout saved yet" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardWeight"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight &amp; Progress" android:textStyle="bold"/>
                <TextView android:id="@+id/tvWeightHome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="No weight entry saved yet" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardRecovery"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recovery Tracker" android:textStyle="bold"/>
                <TextView android:id="@+id/tvRecoveryHome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Complete a recovery check-in" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardProfile"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp"
                android:text="My Profile  ›" android:textColor="@color/text_primary"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardHistory"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp"
                android:text="Progress &amp; History  ›" android:textColor="@color/text_primary"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:layout_marginBottom="18dp" app:cardBackgroundColor="@color/blush_100"
            app:cardCornerRadius="20dp" app:strokeColor="@color/rose_light" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✦ AI WELLNESS COACH" android:textColor="@color/rose_dark" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Your personalized insight"
                    android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvAiInsight" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Generate an insight from your saved wellness data."
                    android:textColor="@color/text_secondary"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAiInsight"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:text="Generate AI Insight" app:cornerRadius="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="@string/medical_disclaimer" android:textColor="@color/text_secondary" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>