<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blush_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹ Back" android:textColor="@color/rose_dark" android:textSize="16sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Progress &amp; History"
            android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Latest recovery" android:textStyle="bold"/>
        <TextView android:id="@+id/tvLatestRecovery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No recovery check-in yet" android:textColor="@color/text_secondary"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Latest hydration" android:textStyle="bold"/>
        <TextView android:id="@+id/tvLatestHydration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No hydration entry yet" android:textColor="@color/text_secondary"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Latest weight" android:textStyle="bold"/>
        <TextView android:id="@+id/tvLatestWeight" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No weight entry yet" android:textColor="@color/text_secondary"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Latest workout" android:textStyle="bold"/>
        <TextView android:id="@+id/tvLatestWorkout" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No workout entry yet" android:textColor="@color/text_secondary"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Recovery history" android:textColor="@color/rose_dark" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/layoutRecoveryHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Weight history" android:textColor="@color/rose_dark" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/layoutWeightHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Workout history" android:textColor="@color/rose_dark" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/layoutWorkoutHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Hydration history" android:textColor="@color/rose_dark" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/layoutHydrationHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>